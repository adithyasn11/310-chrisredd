---
import { asc } from 'drizzle-orm';
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';
import { categories } from '../../db/schema';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const publishers = await getAllPublishers(db);
const categoryOptions = await db
    .select({ id: categories.id, name: categories.name })
    .from(categories)
    .orderBy(asc(categories.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="space-y-6">
          <div class="rounded-xl border border-slate-700 bg-slate-900/50 p-4" data-testid="games-filter-controls">
            <div class="grid gap-4 md:grid-cols-2">
              <label class="block text-sm font-medium text-slate-200" for="category-filter">
                <span class="mb-2 block">Filter by category</span>
                <select
                  id="category-filter"
                  data-testid="category-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">All categories</option>
                  {categoryOptions.map((category) => (
                    <option value={category.id}>{category.name}</option>
                  ))}
                </select>
              </label>

              <label class="block text-sm font-medium text-slate-200" for="publisher-filter">
                <span class="mb-2 block">Filter by publisher</span>
                <select
                  id="publisher-filter"
                  data-testid="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </label>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div
            id="games-empty-state"
            data-testid="games-empty-state"
            class="hidden rounded-xl border border-dashed border-slate-700 bg-slate-900/40 p-8 text-center text-slate-300"
            role="status"
            aria-live="polite"
          >
            No games match the selected filters.
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.getElementById('category-filter');
  const publisherFilter = document.getElementById('publisher-filter');
  const emptyState = document.getElementById('games-empty-state');

  const applyFilters = () => {
    const categoryValue = categoryFilter instanceof HTMLSelectElement ? categoryFilter.value : '';
    const publisherValue = publisherFilter instanceof HTMLSelectElement ? publisherFilter.value : '';
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    let visibleCount = 0;

    for (const card of cards) {
      const isCategoryMatch = categoryValue === '' || card.getAttribute('data-game-category-id') === categoryValue;
      const isPublisherMatch = publisherValue === '' || card.getAttribute('data-game-publisher-id') === publisherValue;
      const shouldShow = isCategoryMatch && isPublisherMatch;
      card.hidden = !shouldShow;

      if (shouldShow) {
        visibleCount += 1;
      }
    }

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    }
  };

  categoryFilter?.addEventListener('change', applyFilters);
  publisherFilter?.addEventListener('change', applyFilters);
  applyFilters();
</script>
